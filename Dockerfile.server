FROM node:22-alpine AS builder

WORKDIR /app/server

COPY server/package*.json ./
RUN npm ci

COPY server/ ./
COPY database/ /app/database/
RUN npm run build

# Runtime dependencies only: keeps build tooling and devDependencies out of
# the production image.
FROM node:22-alpine AS deps

WORKDIR /app/server

COPY server/package*.json ./
RUN npm ci --omit=dev

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
EXPOSE 3001

COPY --from=builder --chown=node:node /app/server/dist ./dist
COPY --from=deps --chown=node:node /app/server/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/server/package.json ./

RUN mkdir -p logs && chown node:node logs

USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
